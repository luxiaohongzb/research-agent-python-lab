RESEARCH_AGENT_RUN_STORE_MODE=memory
RESEARCH_AGENT_EVENT_BROKER_MODE=memory
RESEARCH_AGENT_DISPATCH_MODE=local
RESEARCH_AGENT_CANCELLATION_MODE=memory
RESEARCH_AGENT_ARTIFACT_STORE_MODE=memory
