# Local demo. Never use disabled authentication on a public network.
RESEARCH_AGENT_AUTH_MODE=disabled

# Production example (keep the JSON on one line):
# RESEARCH_AGENT_AUTH_MODE=api_key
# RESEARCH_AGENT_API_KEYS_JSON={"replace-with-a-long-random-key":{"subject":"admin@example.com","tenant_id":"demo","roles":["ADMIN","RESEARCHER","REVIEWER"]}}

RESEARCH_AGENT_PROVIDER_MODE=offline
RESEARCH_AGENT_REASONER_MODE=deterministic
RESEARCH_AGENT_INDEX_MODE=memory
RESEARCH_AGENT_CHECKPOINT_MODE=memory
RESEARCH_AGENT_RUN_STORE_MODE=memory
RESEARCH_AGENT_EVENT_BROKER_MODE=memory
RESEARCH_AGENT_DISPATCH_MODE=local
RESEARCH_AGENT_CANCELLATION_MODE=memory
RESEARCH_AGENT_ARTIFACT_STORE_MODE=memory
RESEARCH_AGENT_TENANT_MAX_ACTIVE_RUNS=5
RESEARCH_AGENT_TENANT_MAX_WORKERS=5
RESEARCH_AGENT_TENANT_MAX_TOTAL_TOKENS=1000000
RESEARCH_AGENT_TENANT_MAX_COST_USD=100
RESEARCH_AGENT_DATABASE_URL=postgresql://research:research@127.0.0.1:5432/research_agent
RESEARCH_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
RESEARCH_AGENT_REDIS_PREFIX=research-agent
RESEARCH_AGENT_REDIS_CONSUMER_GROUP=research-workers
RESEARCH_AGENT_QUEUE_LEASE_SECONDS=60
RESEARCH_AGENT_WORKER_METRICS_PORT=9100
RESEARCH_AGENT_S3_ENDPOINT_URL=http://127.0.0.1:9000
RESEARCH_AGENT_S3_BUCKET=research-artifacts
RESEARCH_AGENT_S3_REGION=us-east-1
RESEARCH_AGENT_S3_ACCESS_KEY_ID=minioadmin
RESEARCH_AGENT_S3_SECRET_ACCESS_KEY=minioadmin
RESEARCH_AGENT_S3_PREFIX=artifacts
RESEARCH_AGENT_GROBID_URL=http://127.0.0.1:8070
RESEARCH_AGENT_GROBID_TIMEOUT_SECONDS=120
RESEARCH_AGENT_RERANKER_MODE=lexical
RESEARCH_AGENT_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RESEARCH_AGENT_WORKER_TIMEOUT_SECONDS=45
RESEARCH_AGENT_OTEL_ENABLED=false
RESEARCH_AGENT_OTEL_SERVICE_NAME=research-agent-python-lab
RESEARCH_AGENT_OPENALEX_EMAIL=
RESEARCH_AGENT_SEMANTIC_SCHOLAR_ENABLED=false
RESEARCH_AGENT_SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_AGENT_MCP_ENABLED=false
RESEARCH_AGENT_MCP_PAPER_SERVERS_JSON=[]
RESEARCH_AGENT_MCP_TIMEOUT_SECONDS=45
# Example Streamable HTTP MCP paper-search server. The named token is read
# from the process environment and is never embedded in this JSON value:
# RESEARCH_AGENT_MCP_ENABLED=true
# RESEARCH_AGENT_MCP_PAPER_SERVERS_JSON=[{"name":"zotero","url":"http://host.docker.internal:3000/mcp","search_tool":"search_papers","bearer_token_env":"MCP_BEARER_TOKEN"}]
# MCP_BEARER_TOKEN=...
RESEARCH_AGENT_REQUEST_TIMEOUT_SECONDS=15
RESEARCH_AGENT_DEFAULT_MAX_PAPERS=8
RESEARCH_AGENT_DEFAULT_MAX_ITERATIONS=2

# Optional live research/model configuration:
# RESEARCH_AGENT_PROVIDER_MODE=hybrid
# RESEARCH_AGENT_OPENALEX_EMAIL=you@example.com
# RESEARCH_AGENT_REASONER_MODE=openai
OPENAI_API_KEY=
RESEARCH_AGENT_MODEL=gpt-5-mini
# DeepSeek uses the OpenAI-compatible Chat Completions API and JSON Output.
# RESEARCH_AGENT_REASONER_MODE=deepseek
DEEPSEEK_API_KEY=
RESEARCH_AGENT_DEEPSEEK_MODEL=deepseek-v4-pro
RESEARCH_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEARCH_AGENT_MODEL_TIMEOUT_SECONDS=60
RESEARCH_AGENT_MODEL_MAX_RETRIES=3
# Pricing changes over time; configure current rates instead of hard-coding them.
RESEARCH_AGENT_MODEL_INPUT_COST_PER_MILLION_USD=
RESEARCH_AGENT_MODEL_OUTPUT_COST_PER_MILLION_USD=
